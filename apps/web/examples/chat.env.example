# Local web development: copy to apps/web/.dev.vars, or run
# node scripts/local/setup-chat.mjs --configure from the repository root.
# Ollama must be running on the SAME machine as the web server.
ATLAS_CHAT_BASE_URL=http://127.0.0.1:11434/v1
ATLAS_CHAT_MODEL=qwen3:0.6b
ATLAS_CHAT_MODELS=qwen3:1.7b,qwen2.5-coder:1.5b
# No API key is needed for local Ollama.

# Alternative: separate endpoints with credentials stored in named variables.
# Profiles replace the single-endpoint settings above. First profile is default.
# ATLAS_CHAT_PROFILES='[{"id":"local","label":"Local Ollama","baseUrl":"http://127.0.0.1:11434/v1","model":"qwen3:0.6b"},{"id":"hosted","label":"Hosted","baseUrl":"https://your-provider.example/v1","model":"your-model","apiKeyEnv":"ATLAS_MODEL_API_KEY"}]'
# ATLAS_MODEL_API_KEY=<real key issued by your provider>
