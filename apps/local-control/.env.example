# Atlas local daemon (apps/local-control) configuration.
#
# The daemon reads the process environment only; it does not load this file.
# Copy it to .env (which git ignores), fill in what you need, and start with
#   node --env-file=.env src/main.mjs
# Every setting is optional: unset means the default shown.
# Never commit a filled-in copy: tokens and passphrases belong in .env only.

# --- Where it runs ---------------------------------------------------------
# Data directory (database, runs, audit logs). Default: ~/.atlas
ATLAS_LOCAL_DATA_DIR=
# Listen address and port. Default: 127.0.0.1 and 4317 (loopback only).
ATLAS_LOCAL_HOST=
ATLAS_LOCAL_PORT=
# 1 opens the signed-in page in the default browser at start.
ATLAS_OPEN_BROWSER=

# --- Models ----------------------------------------------------------------
# OpenAI-compatible endpoint for chat and agents, e.g. Ollama's
# http://127.0.0.1:11434/v1 or llama.cpp's http://127.0.0.1:8080/v1.
ATLAS_MODEL_ENDPOINT=
# Model for the agent team. ATLAS_TEAM_MODEL wins over ATLAS_MODEL.
# Default: qwen2.5-coder:7b
ATLAS_MODEL=
ATLAS_TEAM_MODEL=
# Per-task routes as a JSON array; task is planning, coding, vision or
# summarization. contextWindow is optional (inferred from the model name).
# Example: [{"task":"coding","model":"qwen2.5-coder:14b","endpoint":"http://127.0.0.1:11434/v1"}]
ATLAS_MODEL_ROUTES=
# Speech-to-text endpoint and model. Defaults: http://127.0.0.1:8080/v1, whisper-1
ATLAS_SPEECH_ENDPOINT=
ATLAS_SPEECH_MODEL=

# --- Tools -----------------------------------------------------------------
# MCP servers as a JSON array. Each needs an id, an argv array and the
# allowedTools globs it may expose (nothing is allowed by default).
# Example: [{"id":"files","argv":["npx","-y","@modelcontextprotocol/server-filesystem","/data"],"allowedTools":["read_*"]}]
ATLAS_MCP_SERVERS=
# Optional container isolation for terminal commands. The runtime is an
# absolute path to docker or podman; the image defaults to
# node:22-bookworm-slim. If a named runtime cannot be used, the terminal does
# not start: the daemon never falls back to running commands as you.
ATLAS_TERMINAL_CONTAINER_RUNTIME=
ATLAS_TERMINAL_CONTAINER_IMAGE=
# Browser automation: Chromium channel (default msedge), 1 for headless,
# and extra hosts the URL guard allows (comma-separated; private addresses
# stay blocked otherwise).
ATLAS_BROWSER_CHANNEL=
ATLAS_BROWSER_HEADLESS=
ATLAS_BROWSER_ALLOW_HOSTS=
# Passphrase for the file-backed credential vault, used only when no OS
# keychain is available.
ATLAS_VAULT_PASSPHRASE=

# --- Rendering (ffmpeg / Blender) --------------------------------------------
# Renders run only inside the container sandbox: they need
# ATLAS_TERMINAL_CONTAINER_RUNTIME above plus an image per tool. Unset means
# that tool is unavailable (never run on the host). See docker/render/README.md;
# pin images by digest, e.g. registry.example/atlas-render@sha256:<digest>.
ATLAS_RENDER_FFMPEG_IMAGE=
ATLAS_RENDER_BLENDER_IMAGE=

# --- Rented GPU compute (RunPod Serverless, optional) -------------------------
# Off unless the endpoint id and API key are both set. Store the key in the
# credential vault (preferred) rather than here; an env value is a fallback.
ATLAS_RUNPOD_ENDPOINT_ID=
ATLAS_RUNPOD_API_KEY=
# Monthly cap in US dollars for rented GPUs. Default 0 = GPU spending off.
ATLAS_GPU_MONTHLY_CAP_USD=0
# Optional tuning (defaults shown in docs/atlas-os/COMPUTE.md): GPU pools
# (comma-separated, default AMPERE_24), worker idle timeout (default 5 s),
# cold-start allowance (default 60 s), queue TTL (default 900 s), and JSON
# price overrides.
ATLAS_RUNPOD_GPU_TYPES=
ATLAS_RUNPOD_IDLE_TIMEOUT_SEC=
ATLAS_RUNPOD_COLD_START_SEC=
ATLAS_RUNPOD_QUEUE_TTL_SEC=
ATLAS_RUNPOD_PRICING=

# --- Genesis repair limits ----------------------------------------------------
# A repair loop stops at this many minutes or model tokens (positive whole
# numbers). Unset keeps the defaults (360 minutes, no token limit); an invalid value is reported
# and the default kept.
ATLAS_REPAIR_MAX_MINUTES=
ATLAS_REPAIR_MAX_TOKENS=

# --- Hosted work (optional) ------------------------------------------------
# Dispatch coder tasks to GitHub Actions in this repository (owner/name).
# Needs a token with Actions, Contents and Pull requests read/write.
ATLAS_GITHUB_TOKEN=
ATLAS_GITHUB_REPOSITORY=
# Workflow file and ref to dispatch. Defaults: atlas-coder.yml, main
ATLAS_GITHUB_WORKFLOW=
ATLAS_GITHUB_REF=
# Git host API style for pull requests: github (default) or gitlab.
# ATLAS_GIT_HOST_BASE_URL overrides the API root (for example a Forgejo or
# GitHub Enterprise API URL). Uses ATLAS_GITHUB_TOKEN and ATLAS_GITHUB_REPOSITORY.
ATLAS_GIT_HOST=
ATLAS_GIT_HOST_BASE_URL=
# Deploy providers, enabled only when their token is set.
ATLAS_CLOUDFLARE_TOKEN=
ATLAS_VERCEL_TOKEN=
ATLAS_VERCEL_TEAM_ID=

# --- Licensing -------------------------------------------------------------
# Offline license: set both or neither (neither means the community edition).
ATLAS_OFFLINE_LICENSE_FILE=
ATLAS_LICENSE_PUBLIC_KEY_FILE=

# Bounded owner-only workforce repository and local model.
# ATLAS_WORKFORCE_REPOSITORY=C:/work/project
# ATLAS_WORKFORCE_MODEL=qwen2.5-coder:7b
