<?xml version="1.0" encoding="utf-8"?>
<!--
  Atlas MSI.

  Two decisions worth stating, because they are the ones that make upgrades
  and uninstalls behave:

  * The UpgradeCode is fixed forever. Changing it turns every future upgrade
    into a second parallel installation, which is how people end up with two
    Atlases fighting over the same port.

  * The operator's data lives in %LOCALAPPDATA%\Atlas and is NOT a component
    of this package. MSI removes what it installed; it must never remove the
    encrypted profile, the paired-device credentials, or the session history.
    That is what makes an upgrade preserve pairing and an uninstall survivable.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Atlas"
           Manufacturer="Cornerstone Marketing"
           Version="$(var.AtlasVersion)"
           UpgradeCode="7f3c1f0e-5b3a-4f6d-9a2e-3d1c9b6f4a21"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="Atlas local operator" />

    <!-- Refuses to install over a newer build rather than silently downgrading. -->
    <MajorUpgrade AllowDowngrades="no"
                  DowngradeErrorMessage="A newer version of Atlas is already installed. Uninstall it first if you really want this older build." />

    <MediaTemplate EmbedCab="yes" />

    <Launch Condition="Installed OR VersionNT &gt;= 1000"
            Message="Atlas requires Windows 10 or later." />

    <Feature Id="Main" Title="Atlas" Level="1">
      <ComponentGroupRef Id="AtlasFiles" />
      <ComponentGroupRef Id="AtlasShortcuts" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Atlas">
        <Directory Id="AppsFolder" Name="apps" />
        <Directory Id="ScriptsFolder" Name="scripts" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AtlasMenuFolder" Name="Atlas" />
    </StandardDirectory>

    <ComponentGroup Id="AtlasShortcuts" Directory="AtlasMenuFolder">
      <Component Id="StartMenuShortcuts" Guid="2c9b7d41-8e5a-4b02-9c17-5a8f0d3e6b94">
        <Shortcut Id="StartAtlas"
                  Name="Atlas"
                  Description="Start the Atlas local operator"
                  Target="[INSTALLFOLDER]scripts\windows\Start-AtlasLocal.ps1"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="AtlasDependencies"
                  Name="Atlas — check requirements"
                  Description="Report which prerequisites are present. Installs nothing."
                  Target="[INSTALLFOLDER]scripts\windows\Test-AtlasRequirements.ps1"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAtlasMenuFolder" On="uninstall" />
        <!-- perUser scope, so the marker belongs under HKCU. -->
        <RegistryValue Root="HKCU" Key="Software\Atlas" Name="InstalledVersion"
                       Value="$(var.AtlasVersion)" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      AtlasFiles is generated by heat/harvest at build time from the staged
      payload, so the file list cannot drift from what was actually packaged.
      See scripts/windows/Build-AtlasInstaller.ps1.
    -->
  </Package>
</Wix>
