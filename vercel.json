{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Nothing to install: this project only redirects to the Cloudflare Worker.'",
  "buildCommand": "mkdir -p .vercel-redirect && cp vercel-redirect.html .vercel-redirect/index.html",
  "outputDirectory": ".vercel-redirect",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://atlas-web.cornerstonemarketingus.workers.dev/$1",
      "permanent": false
    }
  ]
}
