  "objective": "Without changing any source file: map which GitHub Actions secrets each workflow uses. For every .yml/.yaml file in .github/workflows, collect the distinct NAME of every secrets.NAME reference that appears inside a ${{ ... }} expression (ignore comments and prose). Write ANSWER.json as {\"workflows\": [{\"file\": \"<file name>\", \"secrets\": [\"NAME\", ...]}, ...], \"shared\": [\"NAME\", ...]} where workflows is sorted by file name and omits workflows that use no secrets, each secrets list is sorted, and shared lists (sorted) the secrets used by two or more workflows.",
  "setup": {
    "files": {}
  },
  "verify": {
    "argv": [
      "node",
      "{repo}/evals/verifiers/answer-check.mjs",
      "{workspace}",
      "workflow-secrets"
    ]
  },
