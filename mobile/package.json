{
  "name": "@atlas/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell around the Atlas responsive web app.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/secure-storage.mjs && node --check src/bridge.mjs && node --check src/deep-link-handler.mjs && node --check src/remote-companion.mjs",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/push-notifications": "8.1.2",
    "capacitor-native-biometric": "^4.2.2",
    "capacitor-secure-storage-plugin": "0.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/android": "8.5.2"
  }
}
